# =====================================================
# Mini E-Commerce Platform — env-overridable cho docker-compose
# Copy file này thành `.env` rồi chỉnh giá trị nếu cần:
#     cp .env.example .env
# Sau đó:  docker compose up -d --build
# =====================================================

# ---------- Hạ tầng chung ----------
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_local
POSTGRES_DB=postgres
POSTGRES_PORT=5433

RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=ecommerce_local
# RabbitMQ AMQP (5672) + management UI (15672) cố định trong compose

# ---------- identity-service (8081) ----------
# Lưu ý: identity-service vẫn hardcode datasource/JWT trong application.properties
#   (chưa refactor sang env-overridable). Docker compose override qua env:
#   SPRING_DATASOURCE_URL / SPRING_DATASOURCE_USERNAME / SPRING_DATASOURCE_PASSWORD.
IDENTITY_SERVER_PORT=8081
SPRING_DATASOURCE_URL_IDENTITY=jdbc:postgresql://postgres:5432/identity_db
SPRING_DATASOURCE_USERNAME=ecommerce
SPRING_DATASOURCE_PASSWORD=ecommerce_local
JWT_ISSUER=mini-ecommerce

# ---------- catalog-service (8082) ----------
CATALOG_SERVER_PORT=8082
CATALOG_DB_URL=jdbc:postgresql://postgres:5432/catalog_db
CATALOG_DB_USERNAME=ecommerce
CATALOG_DB_PASSWORD=ecommerce_local

# ---------- inventory-service (8083) ----------
INVENTORY_SERVER_PORT=8083
INVENTORY_DB_URL=jdbc:postgresql://postgres:5432/inventory_db
INVENTORY_DB_USERNAME=ecommerce
INVENTORY_DB_PASSWORD=ecommerce_local

# ---------- cart-service (8084) ----------
CART_SERVER_PORT=8084
CART_REDIS_HOST=redis
CART_REDIS_PORT=6379

# ---------- order-service (8085) ----------
ORDER_SERVER_PORT=8085
ORDER_DB_URL=jdbc:postgresql://postgres:5432/order_db
ORDER_DB_USERNAME=ecommerce
ORDER_DB_PASSWORD=ecommerce_local
# Order gọi downstream qua mạng Docker (tên service trong compose)
CATALOG_SERVICE_URL=http://catalog-service:8082
INVENTORY_SERVICE_URL=http://inventory-service:8083
CART_SERVICE_URL=http://cart-service:8084
# Outbox poller
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# ---------- api-gateway (8080) ----------
GATEWAY_SERVER_PORT=8080
GATEWAY_CONNECT_TIMEOUT_MS=3000
GATEWAY_RESPONSE_TIMEOUT=5s
FRONTEND_ORIGIN=http://localhost:5173
# Gateway route tới các service qua mạng Docker (compose đã set env trong service definitions)
